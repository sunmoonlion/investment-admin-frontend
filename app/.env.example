# App
NEXT_PUBLIC_APP_NAME=investment-admin
NEXT_PUBLIC_API_URL=/api

# Server-only values. They are read at runtime and must never use the
# NEXT_PUBLIC_ prefix.
DEPLOYMENT_ENV=development
AUTH_APP=investment
APP_ORIGIN=http://localhost:3000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
DEPLOYMENT_ID=local
# info 管理端的地址（可不配）：缺数据的需求页从这里链去发起采集
INFO_ADMIN_URL=http://localhost:3011

# NEXT_PUBLIC_API_URL is intentionally restricted to a same-origin path.
# Authentication, session storage and provider credentials belong to the
# paired FastAPI Admin Backend and must never be placed in this repository.
